easyblock = 'ModuleRC'

name = 'Java'
version = '25'
versionsuffix = '-LTS'

homepage = 'http://java.com/'
description = """Java Platform, Standard Edition (Java SE) lets you develop and deploy
 Java applications on desktops and servers."""

toolchain = SYSTEM

# see https://github.com/easybuilders/easybuild-easyconfigs/blob/develop/easybuild/easyconfigs/j/Java/Java-25.0.5.eb
dependencies = [('Java', '%(version)s.0.5')]

moduleclass = 'lang'
