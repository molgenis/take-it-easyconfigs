easyblock = 'ModuleRC'

name = 'Java'
version = '17'
versionsuffix = '-LTS'

homepage = 'http://java.com/'
description = """Java Platform, Standard Edition (Java SE) lets you develop and deploy
 Java applications on desktops and servers."""

toolchain = SYSTEM

# see https://github.com/easybuilders/easybuild-easyconfigs/blob/easybuild-easyconfigs-v5.4.2/easybuild/easyconfigs/j/Java/Java-17.0.21.eb
dependencies = [('Java', '%(version)s.0.21')]

moduleclass = 'lang'
