name = 'nf_ngs_dna'
version = '1.6.0'

homepage = 'https://github.com/molgenis/nf_ngs_dna/'
description = """Nexflow ngs_dna pipeline used in the UMCG."""

toolchain = {'name': 'GCCcore', 'version': '11.3.0'}
easyblock = 'Tarball'

source_urls = [('https://github.com/molgenis/%s/archive/' % (name))]
sources = [('%s.tar.gz' % (version))]
checksums = [('sha256', 'ac81346f73ffd6382c67e164e414e1f5fdc89dc4efdc5b773b918d0eb6351fec')]

dependencies = [
    ('BCFtools', '1.16'),
    ('BEDTools', '2.30.0'),
    ('gVCF2BED', '1.2.0'),
    ('HTSlib', '1.16'),
]

#
# Sanity checking.
#
sanity_check_paths = {
    'files': ['README.md', 'workflow_dragen.nf'],
    'dirs': ['modules', 'scripts', 'test']

}

moduleclass = 'bio'

